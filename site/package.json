    "@fontsource/special-elite": "5.3.0",
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@shikijs/rehype": "4.6.0",
    "@shikijs/transformers": "4.6.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "estree-util-value-to-estree": "3.5.0",
