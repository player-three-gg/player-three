    "remark-gfm": "4.0.1",
    "shiki": "4.6.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "7.0.2",
    "typescript-for-typedoc": "npm:typescript@6.0.3",
