    "changeset": "changeset",
    "version-packages": "changeset version",
    "verify-pack": "node scripts/verify-pack.mjs",
    "release": "node scripts/release.mjs",
    "banners": "node tools/readme-art/render.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "playwright-core": "1.60.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "typescript": "7.0.2",
      "mathjs": "^15.2.0"
    }
  }
}
