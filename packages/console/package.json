{
  "name": "@playerthree/console",
  "version": "0.1.0",
  "description": "Player console for PlayerThree games: a headless client over the player API for the owner's own seats, plus an optional themeable drop-in panel.",
  "license": "Apache-2.0",
  "homepage": "https://playerthree.gg/packages/console/",
  "repository": { "type": "git", "url": "git+https://github.com/player-three-gg/player-three.git", "directory": "packages/console" },
  "bugs": "https://github.com/player-three-gg/player-three/issues",
  "keywords": ["playerthree", "ai-agents", "multiplayer", "browser"],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "playerthree": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "21.0.4"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE", "NOTICE"]
}
